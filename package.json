{
    "name": "@eliware/module-template",
    "type": "module",
    "version": "1.1.0",
    "description": "A Node.js module-template.",
    "types": "index.d.ts",
    "files": [
        "index.mjs",
        "index.d.ts",
        "README.md",
        "LICENSE",
        "examples"
    ],
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        }
    },
    "scripts": {
        "test": "npx --node-options=\"--experimental-vm-modules --no-warnings\" jest --detectOpenHandles --silent --coverage",
        "test:gaps": "npm test 2>&1 | grep '|' | grep -vF '|     100 |      100 |     100 |     100 |'",
        "lint": "npx oxlint .",
        "typecheck": "tsc --project tsconfig.json",
        "pack": "npm pack --dry-run"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/eliware/module-template.git"
    },
    "keywords": [
        "nodejs",
        "module",
        "template",
        "boilerplate",
        "javascript",
        "typescript",
        "esm",
        "package",
        "library",
        "npm",
        "testing",
        "jest",
        "ci",
        "continuous-integration",
        "node"
    ],
    "author": "Eli Sterling, eliware.org <eli@eliware.org>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/eliware/module-template/issues"
    },
    "homepage": "https://github.com/eliware/module-template#readme",
    "devDependencies": {
        "jest": "^30.4.2",
        "typescript": "^7.0.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "**/?(*.)+(spec|test).[jt]s?(x)",
            "**/?(*.)+(spec|test).mjs"
        ]
    },
    "dependencies": {
        "@eliware/common": "^1.1.8"
    }
}
